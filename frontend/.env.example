# StackRadar Frontend — Environment Variables
# Copy this file to .env.local and fill in your values.

# Where the Next server proxies /api/v1/* to (see next.config.ts). The BROWSER
# never uses this — it calls the page's own origin and Next forwards server-side.
#   • local (next dev / next start on the same host): http://localhost:8000
#   • docker-compose: http://backend:8000  (the compose service name)
#   • hosted (Vercel): your public backend URL, e.g. https://api.stackradar.app
# Note: next.config.ts reads this at BUILD time, so it must be set before build.
BACKEND_ORIGIN=http://localhost:8000

# Absolute site URL — used for OG images, canonical links and the sitemap.
# Set to your real domain in production, e.g. https://stackradar.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clerk Authentication (get keys from https://dashboard.clerk.com)
# Use pk_test_/sk_test_ for dev, pk_live_/sk_live_ in production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here
